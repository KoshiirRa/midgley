# ==============================================================================
# Midgley Environment Configuration Template (.env.example)
# Copy this file to .env and populate with your deployment credentials.
# ==============================================================================

# LLM & AI Reasoning Engine
GEMINI_API_KEY=your_gemini_api_key_here

# Midgley API Security & Administration
MIDGLEY_API_KEY=your_master_api_key_here
MIDGLEY_ADMIN_SECRET=your_admin_secret_here
MIDGLEY_WEBHOOK_SECRET=your_webhook_hmac_secret_here

# Vectorize Hindsight Episodic Agent Memory (Hosted SaaS)
HINDSIGHT_API_KEY=your_hindsight_api_key_here
HINDSIGHT_API_BASE=https://api.hindsight.vectorize.io
HINDSIGHT_BANK_NAME=midgley-memory

# Weights & Biases (W&B) Telemetry & Evaluation
WANDB_API_KEY=your_wandb_api_key_here
WANDB_PROJECT=midgley-gas-forecast
WANDB_ENTITY=your_wandb_entity_here

# Uptime & Cron Monitoring
HEALTHCHECKS_IO_URL=https://hc-ping.com/your-uuid-here

# Cloudflare D1 & Edge Workers (Optional)
CLOUDFLARE_AUTH_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_D1_DATABASE_ID=your_d1_database_id_here

# Turso libSQL Edge Database (Optional)
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token_here

# Upstash Redis Edge Caching (Optional)
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here

# Sentry Error Monitoring (Optional)
SENTRY_DSN=https://your-dsn@sentry.io/project

# External Physical & Commodity Data Feeds (Optional / Free Tier)
FRED_API_KEY=your_fred_api_key_here
EIA_API_KEY=your_eia_api_key_here
PURPLEAIR_API_KEY=your_purpleair_api_key_here
OPENAQ_API_KEY=your_openaq_api_key_here
AIRNOW_API_KEY=your_airnow_api_key_here
FIRECRAWL_API_KEY=your_firecrawl_api_key_here
FINLIGHT_API_KEY=your_finlight_api_key_here
PORTWATCH_API_KEY=your_portwatch_api_key_here

# Server Host & Port
HOST=0.0.0.0
PORT=8000
TESTING=0
